[Unit]
Description=Cowrie SSH/Telnet Honeypot
After=network.target

[Service]
Type=simple
User=cowrie
WorkingDirectory=/home/cowrie/cowrie
ExecStart=/home/cowrie/cowrie/cowrie-env/bin/twistd \
    --nodaemon \
    --umask=0022 \
    cowrie
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
